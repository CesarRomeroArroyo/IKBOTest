# Credenciales exclusivas para desarrollo local. Reemplazar antes de compartir entornos.
MYSQL_DATABASE=product_requests
MYSQL_USER=product_requests
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
JWT_ISSUER=product-requests-local
JWT_AUDIENCE=product-requests-local-client
JWT_SIGNING_KEY=replace_with_at_least_32_random_characters
JWT_EXPIRATION_MINUTES=60
API_PORT=8080
